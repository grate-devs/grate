<?xml version='1.0' encoding='utf-8'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product Name='grate' Manufacturer='grate-devs' Id='%%%PRODUCTCODE%%%'
    UpgradeCode='%%%UPGRADECODE%%%' Language='1033' Codepage='1252' Version='%%%VERSION%%%'>
    <Package Id='*' Keywords='Installer' Description="grate installer"
      Comments='grate - the SQL scripts migration runner' Manufacturer='grate-devs'
      InstallerVersion='500' Languages='1033' InstallScope="perUser" InstallPrivileges="limited" Compressed='yes' SummaryCodepage='1252' />
    <Media Id='1' Cabinet='grate.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1' />
    <Property Id='DiskPrompt' Value="grate Installation [1]" />
    <!-- Full SemVer is recorded, but MSI compares only numeric ProductVersion. -->
    <Property Id='GRATE_RELEASE_VERSION' Value='%%%RELEASEVERSION%%%' />
    <!-- Keep removal inside the installation transaction so failure restores the
         previous product. Stable families handle future releases normally. -->
    <MajorUpgrade Schedule='afterInstallInitialize' DowngradeErrorMessage='A newer version of grate is already installed.' />
    <Binary Id='GrateUpgradeActions' SourceFile='%%%UPGRADEACTIONS%%%' />
    <CustomAction Id='DetectLegacyGrate' BinaryKey='GrateUpgradeActions' DllEntry='DetectLegacyGrate' Execute='immediate' Return='check' />
    <InstallExecuteSequence>
      <Custom Action='DetectLegacyGrate' After='FindRelatedProducts'>NOT Installed AND NOT WIX_DOWNGRADE_DETECTED</Custom>
    </InstallExecuteSequence>

    <Directory Id='TARGETDIR' Name='SourceDir'>

      <Directory Id='LocalAppDataFolder' Name='PFiles'>
        <Directory Id='ROOTDIRECTORY' Name='erikbra'>
          <Directory Id='INSTALLFOLDER' Name='grate'>
            <Component Id='MainExecutable' Guid='C544280E-4F9B-443D-BE6D-4A82CFEE3723'>
              <File Id='grateEXE' Name='grate.exe' DiskId='1' Source='%%%GRATEEXE%%%'/>
              <File Id='ThirdPartyNotices' Name='THIRD-PARTY-NOTICES.txt' DiskId='1' Source='%%%THIRDPARTYNOTICES%%%'/>

              <!-- Remove all files from the INSTALLFOLDER on uninstall -->
              <RemoveFile Id="ALLFILES" Name="*.*" On="both" />
              <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
              <RemoveFolder Id="RemoveCompanyFolder" Directory="ROOTDIRECTORY" On="uninstall" />

              <!--Create application registry entry-->
              <RegistryValue Root="HKCU" Key="Software\Microsoft\erikbra\grate" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <Component Id='PathVariable' Guid='E7507A5D-D78E-4082-BD75-986A11F54E68'>
        <Environment Id='UpdatePath' Name='PATH' Action='set' Permanent='yes' System='no' Part='last' Value='[INSTALLFOLDER]' />
      </Component>
    </Directory>

    <Feature Id='Complete' Level='1'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='PathVariable' />
    </Feature>
  </Product>
</Wix>
