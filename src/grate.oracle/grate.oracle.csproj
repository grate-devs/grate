<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <IsPublishable>false</IsPublishable>
    <InterceptorsNamespaces Condition="'$(PublishAot)' == 'true'">$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Dapper.AOT" Condition="'$(PublishAot)' == 'true'" PrivateAssets="contentfiles;analyzers;build;buildtransitive" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!-- Only NativeAOT source builds opt in; ordinary NuGet packages use Dapper. -->
  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <Compile Remove="DapperAot.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\grate.core\grate.core.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="NuGet.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Bootstrapping\Sql\**\*.sql" />
    <None Remove="Bootstrapping\Sql\**\*.sql" />
  </ItemGroup>
</Project>
