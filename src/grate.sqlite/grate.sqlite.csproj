<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <IsPublishable>false</IsPublishable>
    <TargetFrameworks>netstandard2.0;$(TargetFrameworks)</TargetFrameworks>
    <!-- Let PolySharp also emit trimming attributes (e.g. DynamicallyAccessedMembers) for the ns2.0 target. -->
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- Generates compiler-support polyfills (IsExternalInit, Index/Range, etc.) for the ns2.0 target. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\grate.core\grate.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NuGet.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Bootstrapping\Sql\**\*.sql" />
    <None Remove="Bootstrapping\Sql\**\.sql**" />
  </ItemGroup>

</Project>
