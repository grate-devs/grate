<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>preview</AnalysisLevel>
    <NoWarn>$(NoWarn);CS1591;NU5118;NU5128</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors> 
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <CodeAnalysisRuleset>$(MSBuildThisFileDirectory)CodeAnalysis.ruleset</CodeAnalysisRuleset>
    <EnableXlfLocalization>false</EnableXlfLocalization>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>


  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Keep every net11.0 distribution on the RC3 go-live runtime, including
       self-contained publishes that restore runtime packs independently of the SDK. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <RuntimeFrameworkVersion>11.0.0-rc.3.26522.148</RuntimeFrameworkVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Erik A. Brandstadmoen</Authors>
    <PackageReadmeFile>NuGet.md</PackageReadmeFile>
    <Product>grate database migration</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>
grate - sql for the 20s
    
grate is a no-code, low-fi database migration tool, inspired heavily by RoundhousE. It's written from the ground
up using modern .NET 8/9/10/11. </Description>
    <Copyright>© Erik A. Brandstadmoen. All rights reserved.</Copyright>
    <PackageProjectUrl>https://grate-devs.github.io/grate/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/grate-devs/grate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sql migration roundhouse</PackageTags>
  </PropertyGroup>

</Project>
